{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bhevivision.github.io/universal-skill-library/schemas/material-preparation-result.schema.json",
  "title": "Risultato della preparazione in memoria di un materiale acquisito",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "material",
    "profile",
    "files",
    "skipped",
    "summary",
    "problems"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "status": {
      "enum": ["completed", "partial", "not_available", "blocked", "failed"]
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "original_kind", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "original_kind": {
          "enum": ["file", "directory", "archive", "package", "remote_reference", "unknown", null]
        },
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "profile": { "const": "bounded_text_v1" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "sha256", "bytes", "line_count", "content"],
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^intake/.+"
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 262144 },
          "line_count": { "type": "integer", "minimum": 0 },
          "content": { "type": "string" }
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "reason"],
        "properties": {
          "source": { "type": "string", "pattern": "^intake/.+" },
          "reason": {
            "enum": [
              "unsupported_extension",
              "file_too_large",
              "max_files_reached",
              "total_size_limit",
              "read_error",
              "invalid_utf8",
              "nul_byte"
            ]
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files_examined", "files_skipped", "total_bytes"],
      "properties": {
        "files_examined": { "type": "integer", "minimum": 0, "maximum": 100 },
        "files_skipped": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0, "maximum": 1048576 }
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}