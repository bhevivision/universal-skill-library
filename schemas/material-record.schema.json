{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bhevivision.github.io/universal-skill-library/schemas/material-record.schema.json",
  "title": "Scheda descrittiva del materiale acquisito",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "acquisition",
    "classification",
    "documentation",
    "verification",
    "usability"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "declared_version": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "missing_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "acquired_at",
        "method",
        "original"
      ],
      "properties": {
        "status": {
          "enum": [
            "received",
            "preserved",
            "incomplete",
            "error"
          ]
        },
        "acquired_at": {
          "type": "string",
          "format": "date-time"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string"
        },
        "original": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "file",
                "directory",
                "archive",
                "package",
                "remote_reference",
                "unknown"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "uri": {
              "type": "string",
              "format": "uri"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "digest_algorithm": {
              "enum": [
                "sha256-file-v1",
                "sha256-tree-v2"
              ]
            },
            "byte_size": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "kind"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_examined",
            "in_analysis",
            "classified",
            "provisional",
            "unclassified"
          ]
        },
        "kind": {
          "enum": [
            "skill",
            "possible_skill",
            "tool",
            "agent",
            "workflow",
            "resource",
            "composite",
            "unclassified"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "proposal_id",
              "decision",
              "decided_at",
              "actor",
              "rationale",
              "material_sha256",
              "proposed_kind"
            ],
            "properties": {
              "proposal_id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
              },
              "decision": {
                "enum": [
                  "approved",
                  "rejected"
                ]
              },
              "decided_at": {
                "type": "string",
                "format": "date-time"
              },
              "actor": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "material_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{64}$"
              },
              "proposed_kind": {
                "enum": [
                  "skill",
                  "tool",
                  "agent",
                  "workflow",
                  "resource",
                  "composite",
                  "unclassified"
                ]
              }
            }
          }
        }
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "partial",
            "complete"
          ]
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_verified",
            "in_progress",
            "passed",
            "failed",
            "not_verifiable"
          ]
        },
        "last_checked": {
          "type": "string",
          "format": "date-time"
        },
        "environment": {
          "type": "string"
        },
        "procedure": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "usability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_assessed",
            "available_with_conditions",
            "requires_adapter",
            "incompatible",
            "blocked"
          ]
        },
        "platforms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
