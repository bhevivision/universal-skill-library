{
 "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://bhevivision.github.io/universal-skill-library/schemas/skill-entry.schema.json",
 "title":"Voce del catalogo skill","type":"object","additionalProperties":false,
 "required":["id","path","capability_ids","scope","version","lifecycle","selection"],
 "properties":{
  "id":{"type":"string","pattern":"^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
  "path":{"type":"string","pattern":"^skills/[a-z0-9]+(?:-[a-z0-9]+)*/SKILL\\.md$"},
  "capability_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9]+(?:[.-][a-z0-9]+)*$"}},
  "scope":{"enum":["universal","platform","project"]},"version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
  "lifecycle":{"enum":["stable","experimental","unverified","deprecated","blocked"]},
  "platforms":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
  "tags":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
  "selection":{"type":"object","additionalProperties":false,"required":["task_signals","inputs","outputs","prerequisites","constraints","risk_level","verification"],
   "properties":{
    "task_signals":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "inputs":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["name","description","required","format"],"properties":{"name":{"type":"string","minLength":1},"description":{"type":"string","minLength":1},"required":{"type":"boolean"},"format":{"type":"string","minLength":1}}}},
    "outputs":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["name","description","format"],"properties":{"name":{"type":"string","minLength":1},"description":{"type":"string","minLength":1},"format":{"type":"string","minLength":1}}}},
    "prerequisites":{"type":"array","items":{"type":"string","minLength":1}},"constraints":{"type":"array","items":{"type":"string","minLength":1}},
    "risk_level":{"enum":["low","medium","high","critical"]},
    "verification":{"type":"object","additionalProperties":false,"required":["status","last_checked","evidence_refs"],"properties":{"status":{"enum":["not_run","passed","failed","inconclusive"]},"last_checked":{"type":"string","format":"date-time"},"evidence_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}},"allOf":[{"if":{"properties":{"status":{"not":{"const":"not_run"}}},"required":["status"]},"then":{"required":["last_checked"],"properties":{"evidence_refs":{"minItems":1}}}}]}
   }
  }
 },
 "allOf":[{"if":{"properties":{"scope":{"const":"platform"}},"required":["scope"]},"then":{"required":["platforms"],"properties":{"platforms":{"minItems":1}}}},{"if":{"properties":{"lifecycle":{"const":"stable"}},"required":["lifecycle"]},"then":{"properties":{"selection":{"properties":{"verification":{"properties":{"status":{"const":"passed"}},"required":["status"]}}}}}}]
}