{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bhevivision.github.io/universal-skill-library/schemas/skill-entry.schema.json",
  "title": "Skill catalog entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "path",
    "capability_ids",
    "scope",
    "version",
    "lifecycle"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "pattern": "^skills/[a-z0-9]+(?:-[a-z0-9]+)*/SKILL\\.md$"
    },
    "capability_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "enum": [
        "universal",
        "platform",
        "project"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "lifecycle": {
      "enum": [
        "stable",
        "experimental",
        "unverified",
        "deprecated",
        "blocked"
      ]
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  }
}
