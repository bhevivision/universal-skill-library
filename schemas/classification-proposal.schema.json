{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bhevivision.github.io/universal-skill-library/schemas/classification-proposal.schema.json",
  "title": "Proposta di classificazione statica",
  "description": "Proposta non approvata prodotta dal classificatore statico. Non abilita l'esecuzione o l'uso del materiale.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_schema_version",
    "proposal_id",
    "created_at",
    "status",
    "material",
    "proposal",
    "evidence",
    "dependencies",
    "missing_references",
    "unknowns",
    "limits",
    "analysis"
  ],
  "properties": {
    "proposal_schema_version": { "const": "1.0" },
    "proposal_id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "const": "pending_approval" },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256", "original_kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "original_kind": { "enum": ["file", "directory", "archive", "package", "remote_reference", "unknown"] }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "confidence", "rationale"],
      "properties": {
        "kind": { "enum": ["skill", "tool", "agent", "workflow", "resource", "composite", "unclassified"] },
        "confidence": { "enum": ["low", "medium", "high"] },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "type", "material_id", "sha256"],
            "properties": {
              "source": { "const": "catalog/materials.json" },
              "type": { "const": "identity" },
              "material_id": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "type", "sha256", "bytes"],
            "properties": {
              "source": { "type": "string", "pattern": "^intake/.+" },
              "type": { "const": "text_file" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "bytes": { "type": "integer", "minimum": 0 }
            }
          }
        ]
      }
    },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "missing_references": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "limits": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "files_examined"],
      "properties": {
        "method": { "const": "bounded_static_text_v1" },
        "files_examined": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
