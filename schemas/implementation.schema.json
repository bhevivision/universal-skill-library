{
 "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://bhevivision.github.io/universal-skill-library/schemas/implementation.schema.json",
 "title":"Voce del catalogo implementazioni","type":"object","additionalProperties":false,
 "required":["id","skill_id","skill_version","platform","path","requirements","tool_requirements","permissions_required","agent_compatibility","status","verification"],
 "properties":{
  "id":{"type":"string","pattern":"^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},"skill_id":{"type":"string","pattern":"^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
  "skill_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},"platform":{"type":"string","minLength":1},
  "path":{"type":"string","pattern":"^implementations/[a-z0-9-]+/[a-z0-9-]+/manifest\\.json$"},
  "requirements":{"type":"array","items":{"type":"string","minLength":1}},"tool_requirements":{"type":"array","items":{"type":"string","minLength":1}},
  "permissions_required":{"type":"array","items":{"type":"string","minLength":1}},
  "agent_compatibility":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["agent","versions"],"properties":{"agent":{"type":"string","minLength":1},"versions":{"type":"string","minLength":1}}}},
  "status":{"enum":["draft","available","unverified","verified","deprecated","blocked"]},
  "verification":{"type":"object","additionalProperties":false,"required":["status","evidence_refs"],"properties":{"status":{"enum":["not_run","passed","failed","inconclusive"]},"last_checked":{"type":"string","format":"date-time"},"evidence_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}},"allOf":[{"if":{"properties":{"status":{"not":{"const":"not_run"}}},"required":["status"]},"then":{"required":["last_checked"],"properties":{"evidence_refs":{"minItems":1}}}}]}
 },
 "allOf":[{"if":{"properties":{"status":{"const":"verified"}},"required":["status"]},"then":{"properties":{"verification":{"properties":{"status":{"const":"passed"}},"required":["status"]}}}}]
}