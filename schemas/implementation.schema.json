{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bhevivision.github.io/universal-skill-library/schemas/implementation.schema.json",
  "title": "Skill implementation entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "skill_id",
    "skill_version",
    "platform",
    "path",
    "requirements",
    "permissions_required",
    "status",
    "verification"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "skill_id": {
      "type": "string"
    },
    "skill_version": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "pattern": "^implementations/[a-z0-9-]+/[a-z0-9-]+/manifest\\.json$"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permissions_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "draft",
        "available",
        "unverified",
        "verified",
        "deprecated",
        "blocked"
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_run",
            "passed",
            "failed",
            "inconclusive"
          ]
        },
        "last_checked": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
