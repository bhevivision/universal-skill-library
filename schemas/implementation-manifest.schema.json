{
 "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://bhevivision.github.io/universal-skill-library/schemas/implementation-manifest.schema.json",
 "title":"Manifest di implementazione","type":"object","additionalProperties":false,"required":["id","skill_id","skill_version","platform"],
 "properties":{"id":{"type":"string","pattern":"^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},"skill_id":{"type":"string","pattern":"^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},"skill_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},"platform":{"type":"string","minLength":1},"entrypoint":{"type":"string","minLength":1},"notes":{"type":"string"}}
}